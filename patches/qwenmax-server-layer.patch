+// QwenMax: HTTP-triggered graceful shutdown (POST /max/shutdown).
+//
+// On Windows there is no reliable way to deliver CTRL_C_EVENT to a child
+// process from a supervisor (AttachConsole across processes is brittle), so
+// the supervisor (max.py) stops us over HTTP instead. We answer first,
+// then a short-delay detached thread enters the exact same shutdown path as
+// Ctrl+C: ctx_server.terminate() -> start_loop() returns -> clean_up ->
+// ~server_context_impl -> destroy(), which flushes idle slot KV/SSM states
+// to the SSD cache pool before exit.
+static server_http_res_ptr handle_max_shutdown(const server_http_req &) {
+    std::thread([]{
+        std::this_thread::sleep_for(std::chrono::milliseconds(200));
+        llama_server_terminate();
+    }).detach();
+
+    auto res = std::make_unique<server_http_res>();
+    res->status = 200;
+    res->data = safe_json_to_str({{"stopping", true}});
