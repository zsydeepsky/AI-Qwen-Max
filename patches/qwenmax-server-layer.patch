diff --git a/tools/server/ssd-prompt-cache.cpp b/tools/server/ssd-prompt-cache.cpp
new file mode 100644
index 0000000..92a5c4a
--- /dev/null
+++ b/tools/server/ssd-prompt-cache.cpp
@@ -0,0 +1,639 @@
+#include "ssd-prompt-cache.h"
+
+#include "server-common.h"   // SRV_* logging macros
+#include "llama.h"
+
+#include <algorithm>
+#include <chrono>
+#include <filesystem>
+#include <fstream>
+#include <vector>
+
+//
+// server_prompt_cache_ssd
+//
+
+namespace {
+
+constexpr uint32_t SSD_CACHE_MAGIC_INDEX = 0x53534449; // "SSDI"
+constexpr uint32_t SSD_CACHE_MAGIC_STATE = 0x53534443; // "SSDC"
+constexpr uint32_t SSD_CACHE_VERSION     = 2;
+
+static_assert(sizeof(llama_pos) == sizeof(int32_t), "unexpected llama_pos size");
+
+// FNV-1a 64-bit
+uint64_t ssd_hash_str(const std::string & s) {
+    uint64_t h = 14695981039346656037ull;
+    for (const char c : s) {
+        h ^= (uint8_t) c;
+        h *= 1099511628211ull;
+    }
+    return h;
+}
+
+int64_t ssd_time_ms() {
+    return std::chrono::duration_cast<std::chrono::milliseconds>(
+            std::chrono::system_clock::now().time_since_epoch()).count();
+}
+
+// plain-token LCP with the same semantics as server_tokens::get_common_prefix (text-only)
+size_t ssd_common_prefix(const llama_tokens & a, const server_tokens & b) {
+    // QwenMax: has_mtmd is a model-level flag once a mmproj is loaded - test for actual media instead
+    GGML_ASSERT(b.find_next_media_chunk(0).first == nullptr);
+
+    const auto & bt = b.get_tokens();
+
+    const size_t max_idx = std::min(a.size(), bt.size());
+
+    for (size_t i = 0; i < max_idx; ++i) {
+        if (a[i] != bt[i]) {
+            return i;
+        }
+    }
+
+    return max_idx;
+}
+
+// POD + blob writer over an ofstream
+struct ssd_file_writer {
+    std::ofstream f;
+
+    explicit ssd_file_writer(const std::string & path) : f(path, std::ios::binary) {}
+
+    bool good() const { return f.good(); }
+
+    template <typename T>
+    void write(const T & v) {
+        static_assert(std::is_trivially_copyable<T>::value, "T must be trivially copyable");
+        f.write(reinterpret_cast<const char *>(&v), sizeof(v));
+    }
+
+    void write_blob(const void * p, size_t n) {
+        write<uint64_t>(n);
+        if (n > 0) {
+            f.write(reinterpret_cast<const char *>(p), n);
+        }
+    }
+
+    void write_blob(const std::vector<uint8_t> & v) {
+        write_blob(v.data(), v.size());
+    }
+};
+
+// POD + blob reader over an ifstream
+struct ssd_file_reader {
+    std::ifstream f;
+
+    explicit ssd_file_reader(const std::string & path) : f(path, std::ios::binary) {}
+
+    bool good() const { return f.good(); }
+
+    template <typename T>
+    T read() {
+        static_assert(std::is_trivially_copyable<T>::value, "T must be trivially copyable");
+        T v;
+        f.read(reinterpret_cast<char *>(&v), sizeof(v));
+        if (!f.good()) {
+            throw std::runtime_error("unexpected end of ssd cache file");
+        }
+        return v;
+    }
+
+    std::vector<uint8_t> read_blob() {
+        const uint64_t n = read<uint64_t>();
+        if (n > (1ull << 40)) {
+            throw std::runtime_error("implausible blob size in ssd cache file");
+        }
+        std::vector<uint8_t> v(n);
+        if (n > 0) {
+            f.read(reinterpret_cast<char *>(v.data()), n);
+            if (!f.good()) {
+                throw std::runtime_error("unexpected end of ssd cache file");
+            }
+        }
+        return v;
+    }
+};
+
+} // namespace
+
+server_prompt_cache_ssd::server_prompt_cache_ssd(std::string path, uint64_t fingerprint, int32_t limit_size_mib, int64_t ttl_hours, bool keep_on_load) {
+    namespace fs = std::filesystem;
+
+    this->fingerprint = fingerprint;
+    this->limit_size  = 1024ull*1024ull*(limit_size_mib < 0 ? 0 : limit_size_mib);
+    this->ttl_ms      = 3600ull*1000ull*std::max<int64_t>(0, ttl_hours);
+    this->keep_on_load = keep_on_load;
+    this->path_dir    = fs::path(path).string();
+    this->path_index  = (fs::path(path_dir) / "index.bin").string();
+}
+
+server_prompt_cache_ssd::~server_prompt_cache_ssd() = default;
+
+uint64_t server_prompt_cache_ssd::make_fingerprint(const std::string & s) {
+    return ssd_hash_str(s);
+}
+
+bool server_prompt_cache_ssd::init() {
+    namespace fs = std::filesystem;
+
+    std::error_code ec;
+
+    if (!fs::exists(path_dir, ec)) {
+        fs::create_directories(path_dir, ec);
+        if (ec) {
+            SRV_ERR("ssd cache: failed to create directory '%s': %s\n", path_dir.c_str(), ec.message().c_str());
+            return false;
+        }
+        return true;
+    }
+
+    try {
+        if (fs::exists(path_index)) {
+            ssd_file_reader r(path_index);
+
+            const uint32_t magic = r.read<uint32_t>();
+            const uint32_t ver   = r.read<uint32_t>();
+
+            if (magic == SSD_CACHE_MAGIC_INDEX && ver == SSD_CACHE_VERSION && r.read<uint64_t>() == fingerprint) {
+                next_id = r.read<uint64_t>();
+
+                const uint32_t n = r.read<uint32_t>();
+                for (uint32_t i = 0; i < n; ++i) {
+                    entry e;
+
+                    e.id         = r.read<uint64_t>();
+                    e.t_last_use = r.read<int64_t>();
+                    e.size_total = r.read<uint64_t>();
+
+                    const uint32_t n_tok = r.read<uint32_t>();
+                    e.tokens.resize(n_tok);
+                    if (n_tok > 0) {
+                        r.f.read(reinterpret_cast<char *>(e.tokens.data()), n_tok * sizeof(llama_token));
+                        if (!r.f.good()) {
+                            throw std::runtime_error("unexpected end of ssd cache index");
+                        }
+                    }
+
+                    // drop entries whose state file went missing
+                    const auto path_state = (fs::path(path_dir) / ("state_" + std::to_string(e.id) + ".bin")).string();
+                    if (!fs::exists(path_state)) {
+                        SRV_WRN("ssd cache: state file for entry %llu is missing, dropping\n", (unsigned long long) e.id);
+                        continue;
+                    }
+
+                    next_id = std::max<size_t>(next_id, e.id + 1);
+
+                    entries.push_back(std::move(e));
+                }
+            } else {
+                SRV_WRN("%s", "ssd cache: index fingerprint or format mismatch, wiping directory\n");
+
+                fs::remove_all(path_dir, ec);
+                fs::create_directories(path_dir, ec);
+
+                entries.clear();
+                next_id = 1;
+            }
+        }
+    } catch (const std::exception & e) {
+        SRV_WRN("ssd cache: failed to read index (%s), wiping directory\n", e.what());
+
+        fs::remove_all(path_dir, ec);
+        fs::create_directories(path_dir, ec);
+
+        entries.clear();
+        next_id = 1;
+    }
+
+    cleanup_expired();  // drop entries idle beyond the TTL (if configured) before reporting
+
+    SRV_INF("ssd cache: %zu entries, %.3f MiB (limit: %.3f MiB), dir: %s\n",
+            entries.size(), size() / (1024.0 * 1024.0), limit_size / (1024.0 * 1024.0), path_dir.c_str());
+
+    return true;
+}
+
+bool server_prompt_cache_ssd::save_index() const {
+    namespace fs = std::filesystem;
+
+    // QwenMax: atomic write (tmp + rename), same as save_state.
+    // A crash mid-write must not corrupt index.bin - init() wipes the whole
+    // cache directory when the index fails to load, so a torn index would
+    // take down every otherwise-intact state file with it.
+    const auto path_tmp = path_index + ".tmp";
+
+    try {
+        {
+            ssd_file_writer w(path_tmp);
+
+            if (!w.good()) {
+                return false;
+            }
+
+            w.write<uint32_t>(SSD_CACHE_MAGIC_INDEX);
+            w.write<uint32_t>(SSD_CACHE_VERSION);
+            w.write<uint64_t>(fingerprint);
+            w.write<uint64_t>(next_id);
+            w.write<uint32_t>((uint32_t) entries.size());
+
+            for (const auto & e : entries) {
+                w.write<uint64_t>(e.id);
+                w.write<int64_t>(e.t_last_use);
+                w.write<uint64_t>(e.size_total);
+                w.write<uint32_t>((uint32_t) e.tokens.size());
+                if (!e.tokens.empty()) {
+                    w.f.write(reinterpret_cast<const char *>(e.tokens.data()), e.tokens.size() * sizeof(llama_token));
+                }
+            }
+
+            if (!w.good()) {
+                std::error_code ec;
+                fs::remove(path_tmp, ec);
+                return false;
+            }
+        }
+
+        std::error_code ec;
+        fs::rename(path_tmp, path_index, ec);
+        if (ec) {
+            // windows: rename onto an existing file fails - remove and retry
+            fs::remove(path_index, ec);
+            fs::rename(path_tmp, path_index, ec);
+            if (ec) {
+                SRV_WRN("ssd cache: failed to finalize index '%s': %s\n", path_index.c_str(), ec.message().c_str());
+                fs::remove(path_tmp, ec);
+                return false;
+            }
+        }
+
+        return true;
+    } catch (const std::exception & e) {
+        SRV_WRN("ssd cache: failed to write index: %s\n", e.what());
+        std::error_code ec;
+        fs::remove(path_tmp, ec);
+        return false;
+    }
+}
+
+void server_prompt_cache_ssd::remove_entry(std::list<entry>::iterator it) {
+    namespace fs = std::filesystem;
+
+    std::error_code ec;
+
+    const auto path_state = (fs::path(path_dir) / ("state_" + std::to_string(it->id) + ".bin")).string();
+    fs::remove(path_state, ec);
+
+    entries.erase(it);
+}
+
+void server_prompt_cache_ssd::cleanup_expired() {
+    if (ttl_ms <= 0 || entries.empty()) {
+        return;
+    }
+
+    const int64_t now = ssd_time_ms();
+
+    bool changed = false;
+
+    auto it = entries.begin();
+    while (it != entries.end()) {
+        if (now - it->t_last_use > ttl_ms) {
+            SRV_INF("ssd cache: ttl cleanup, removing entry %llu (last used %lld s ago)\n",
+                    (unsigned long long) it->id, (long long) (now - it->t_last_use) / 1000);
+
+            const auto todel = it++;
+            remove_entry(todel);
+            changed = true;
+        } else {
+            ++it;
+        }
+    }
+
+    if (changed) {
+        save_index();
+    }
+}
+
+void server_prompt_cache_ssd::make_room(size_t size_new) {
+    if (limit_size == 0) {
+        return;
+    }
+
+    while (!entries.empty() && size() + size_new > limit_size) {
+        SRV_WRN("ssd cache: making room, removing oldest entry (size = %.3f MiB)\n",
+                entries.front().size_total / (1024.0 * 1024.0));
+
+        remove_entry(entries.begin());
+    }
+}
+
+bool server_prompt_cache_ssd::save_state(const server_prompt_cache_state & state) {
+    namespace fs = std::filesystem;
+
+    cleanup_expired();  // lazy TTL cleanup before touching the index
+
+    // QwenMax: reject only states that actually contain media chunks. has_mtmd alone is not a
+    // reliable signal (it used to be forced true by mmproj presence) and would drop pure-text
+    // states, silently disabling the SSD cache once a mmproj is loaded.
+    if (state.prompt.tokens.find_next_media_chunk(0).first != nullptr) {
+        // v1: text-only prompts
+        return false;
+    }
+
+    const auto & toks = state.prompt.tokens.get_tokens();
+
+    if (toks.empty()) {
+        return false;
+    }
+
+    const size_t size_total = state.size();
+
+    if (limit_size > 0 && size_total > limit_size) {
+        SRV_WRN("ssd cache: state size %.3f MiB exceeds limit %.3f MiB, skipping\n",
+                size_total / (1024.0 * 1024.0), limit_size / (1024.0 * 1024.0));
+        return false;
+    }
+
+    make_room(size_total);
+
+    const auto t_start = std::chrono::steady_clock::now();
+
+    try {
+        const auto id = next_id++;
+
+        const auto path_state = (fs::path(path_dir) / ("state_" + std::to_string(id) + ".bin")).string();
+        const auto path_tmp  = path_state + ".tmp";
+
+        {
+            ssd_file_writer w(path_tmp);
+
+            if (!w.good()) {
+                SRV_WRN("ssd cache: cannot open '%s' for writing\n", path_tmp.c_str());
+                return false;
+            }
+
+            w.write<uint32_t>(SSD_CACHE_MAGIC_STATE);
+            w.write<uint32_t>(SSD_CACHE_VERSION);
+            w.write<uint64_t>(fingerprint);
+
+            // v2: raw token vector (text-only prompts; media-bearing states are skipped upstream)
+            w.write_blob(toks.data(), toks.size() * sizeof(llama_token));
+
+            w.write<uint32_t>((uint32_t) state.prompt.checkpoints.size());
+            for (const auto & ckpt : state.prompt.checkpoints) {
+                w.write<int64_t>(ckpt.n_tokens);
+                w.write<int32_t>(ckpt.id_task);
+                w.write<int32_t>(ckpt.pos_min);
+                w.write<int32_t>(ckpt.pos_max);
+
+                w.write_blob(ckpt.data_tgt);
+                w.write_blob(ckpt.data_dft);
+                w.write_blob(ckpt.data_spec);
+            }
+
+            w.write_blob(state.data.main);
+            w.write_blob(state.data.drft);
+        }
+
+        std::error_code ec;
+        fs::rename(path_tmp, path_state, ec);
+        if (ec) {
+            // windows: rename onto an existing file fails - remove and retry
+            fs::remove(path_state, ec);
+            fs::rename(path_tmp, path_state, ec);
+            if (ec) {
+                SRV_WRN("ssd cache: failed to finalize '%s': %s\n", path_state.c_str(), ec.message().c_str());
+                fs::remove(path_tmp, ec);
+                return false;
+            }
+        }
+
+        entry e;
+        e.id         = id;
+        e.t_last_use = ssd_time_ms();
+        e.size_total = size_total;
+        e.tokens     = toks;
+
+        entries.push_back(std::move(e));
+
+        save_index();
+
+        const auto t_dur = std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::steady_clock::now() - t_start).count();
+
+        SRV_INF("ssd cache: saved %zu tokens, %.3f MiB in %lld ms (%.1f MiB/s), entries: %zu, total: %.3f MiB\n",
+                toks.size(), size_total / (1024.0 * 1024.0), (long long) t_dur,
+                t_dur > 0 ? (size_total / (1024.0 * 1024.0)) / (t_dur / 1000.0) : 0.0f,
+                entries.size(), size() / (1024.0 * 1024.0));
+
+        return true;
+    } catch (const std::exception & e) {
+        SRV_WRN("ssd cache: failed to save state: %s\n", e.what());
+        return false;
+    }
+}
+
+bool server_prompt_cache_ssd::load_state(server_prompt & prompt, const server_tokens & tokens_new,
+        llama_context * ctx_tgt, llama_context * ctx_dft, int32_t id_slot,
+        float f_keep_min, float f_sim_min) {
+    namespace fs = std::filesystem;
+
+    cleanup_expired();  // lazy TTL cleanup before matching
+
+    // QwenMax: same actual-media check as save_state (has_mtmd is unreliable once mmproj loaded)
+    if (tokens_new.find_next_media_chunk(0).first != nullptr) {
+        // v1: text-only prompts
+        return false;
+    }
+
+    auto it_best = entries.end();
+
+    for (auto it = entries.begin(); it != entries.end(); ++it) {
+        const size_t lcp_cur = ssd_common_prefix(it->tokens, tokens_new);
+
+        const float f_keep_cur = float(lcp_cur) / it->tokens.size();
+        const float f_sim_cur  = float(lcp_cur) / tokens_new.size();
+
+        // don't trash large prompts
+        if (f_keep_cur < 0.25f) {
+            continue;
+        }
+
+        if (f_keep_min < f_keep_cur && f_sim_min < f_sim_cur) {
+            f_keep_min = f_keep_cur;
+            f_sim_min  = f_sim_cur;
+
+            it_best = it;
+        }
+    }
+
+    if (it_best == entries.end()) {
+        return false;
+    }
+
+    SRV_INF("ssd cache: candidate entry %llu with f_keep = %.3f, f_sim = %.3f\n",
+            (unsigned long long) it_best->id, f_keep_min, f_sim_min);
+
+    const auto t_start = std::chrono::steady_clock::now();
+
+    bool ok = false;
+
+    try {
+        const auto path_state = (fs::path(path_dir) / ("state_" + std::to_string(it_best->id) + ".bin")).string();
+
+        ssd_file_reader r(path_state);
+
+        if (!r.good()) {
+            throw std::runtime_error("cannot open state file");
+        }
+
+        if (r.read<uint32_t>() != SSD_CACHE_MAGIC_STATE || r.read<uint32_t>() != SSD_CACHE_VERSION || r.read<uint64_t>() != fingerprint) {
+            throw std::runtime_error("state file format or fingerprint mismatch");
+        }
+
+        const auto tokens_raw = r.read_blob();
+
+        // v2: raw token vector, padded to llama_token granularity
+        llama_tokens packed(reinterpret_cast<const llama_token *>(tokens_raw.data()),
+                            reinterpret_cast<const llama_token *>(tokens_raw.data()) + tokens_raw.size() / sizeof(llama_token));
+
+        server_prompt prompt_new;
+
+        prompt_new.tokens = server_tokens(packed, /* has_mtmd */ false);
+
+        const uint32_t n_ckpt = r.read<uint32_t>();
+        for (uint32_t i = 0; i < n_ckpt; ++i) {
+            common_prompt_checkpoint ckpt;
+
+            ckpt.n_tokens = r.read<int64_t>();
+            ckpt.id_task  = r.read<int32_t>();
+            ckpt.pos_min  = r.read<int32_t>();
+            ckpt.pos_max  = r.read<int32_t>();
+
+            ckpt.data_tgt  = r.read_blob();
+            ckpt.data_dft  = r.read_blob();
+            ckpt.data_spec = r.read_blob();
+
+            prompt_new.checkpoints.push_back(std::move(ckpt));
+        }
+
+        auto data_main = r.read_blob();
+        auto data_drft = r.read_blob();
+
+        {
+            const size_t sz = data_main.size();
+            const size_t n = llama_state_seq_set_data_ext(ctx_tgt, data_main.data(), sz, id_slot, 0);
+            if (n != sz) {
+                throw std::runtime_error("failed to restore tgt state with size " + std::to_string(sz) + " (got " + std::to_string(n) + ")");
+            }
+        }
+
+        if (!data_drft.empty()) {
+            GGML_ASSERT(ctx_dft);
+
+            const size_t sz = data_drft.size();
+            const size_t n = llama_state_seq_set_data_ext(ctx_dft, data_drft.data(), sz, id_slot, 0);
+            if (n != sz) {
+                throw std::runtime_error("failed to restore dft state with size " + std::to_string(sz) + " (got " + std::to_string(n) + ")");
+            }
+        }
+
+        prompt = std::move(prompt_new);
+
+        ok = true;
+    } catch (const std::exception & e) {
+        SRV_WRN("ssd cache: failed to load state: %s\n", e.what());
+    }
+
+    // api-cache mode: one-shot restore - the slot now owns the state.
+    // snapshot mode: keep the entry for future hits, just record the hit time
+    // (t_last_use is the "last hit" record that feeds the long idle TTL).
+    const size_t size_restored = it_best->size_total;
+
+    if (ok) {
+        if (keep_on_load) {
+            it_best->t_last_use = ssd_time_ms();
+        } else {
+            remove_entry(it_best);
+        }
+        save_index();
+    } else {
+        // keep the entry so a future request can retry loading it
+        // (e.g. a transient read failure should not destroy cached state)
+        SRV_WRN("ssd cache: keeping entry %llu after failed load\n",
+                (unsigned long long) it_best->id);
+    }
+
+    if (ok) {
+        const auto t_dur = std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::steady_clock::now() - t_start).count();
+
+        SRV_INF("ssd cache: restored %zu tokens (%.3f MiB) in %lld ms (%.1f MiB/s), entries left: %zu\n",
+                prompt.tokens.size(), size_restored / (1024.0 * 1024.0), (long long) t_dur,
+                t_dur > 0 ? (size_restored / (1024.0 * 1024.0)) / (t_dur / 1000.0) : 0.0f,
+                entries.size());
+    }
+
+    return ok;
+}
+
+void server_prompt_cache_ssd::remove_contained(const server_tokens & tokens_new) {
+    // QwenMax: actual-media check (has_mtmd is unreliable once mmproj loaded)
+    if (tokens_new.find_next_media_chunk(0).first != nullptr) {
+        // v1: text-only prompts
+        return;
+    }
+
+    bool removed = false;
+
+    for (auto it = entries.begin(); it != entries.end();) {
+        if (ssd_common_prefix(it->tokens, tokens_new) == it->tokens.size()) {
+            SRV_TRC("ssd cache: removing obsolete entry %llu with length %zu\n", (unsigned long long) it->id, it->tokens.size());
+
+            const auto todel = it++;   // advance before erase (remove_entry invalidates it)
+            remove_entry(todel);
+            removed = true;
+        } else {
+            ++it;
+        }
+    }
+
+    if (removed) {
+        save_index();
+    }
+}
+
+bool server_prompt_cache_ssd::contains(const server_tokens & tokens_new) const {
+    // QwenMax: actual-media check (has_mtmd is unreliable once mmproj loaded)
+    if (tokens_new.find_next_media_chunk(0).first != nullptr) {
+        // v1: text-only prompts
+        return false;
+    }
+
+    for (const auto & e : entries) {
+        if (ssd_common_prefix(e.tokens, tokens_new) == tokens_new.size()) {
+            return true;
+        }
+    }
+
+    return false;
+}
+
+size_t server_prompt_cache_ssd::size() const {
+    size_t res = 0;
+
+    for (const auto & e : entries) {
+        res += e.size_total;
+    }
+
+    return res;
+}
+
+size_t server_prompt_cache_ssd::n_tokens() const {
+    size_t res = 0;
+
+    for (const auto & e : entries) {
+        res += e.tokens.size();
+    }
+
+    return res;
+}
diff --git a/tools/server/ssd-prompt-cache.h b/tools/server/ssd-prompt-cache.h
new file mode 100644
index 0000000..9e7b347
--- /dev/null
+++ b/tools/server/ssd-prompt-cache.h
@@ -0,0 +1,109 @@
+#pragma once
+
+#include "server-task.h"
+
+#include "llama.h"
+
+#include <list>
+#include <string>
+
+// SSD persistence layer for the prompt cache (QwenMax extension)
+// qwenmax extension - do not merge upstream: standalone file so upstream server
+// files only carry a handful of hook calls (see [QwenMax C01] marks).
+//
+// Layout:
+//   <path>/index.bin       - entry metadata + tokens for LCP matching without reading state files
+//   <path>/state_<id>.bin  - serialized server_prompt_cache_state (tokens, checkpoints, tgt/dft data)
+//
+// Entries are keyed by a fingerprint (model identity + build number). A fingerprint mismatch
+// wipes the whole directory on startup.
+//
+// Two usage modes (set by keep_on_load):
+//   api-cache mode (keep_on_load=false, default): one-shot entries - a successful
+//     load_state() consumes and deletes the entry (the slot now owns the state).
+//     Capacity-limited (make_room) + LRU/TTL eviction.
+//   snapshot mode (keep_on_load=true): persistent entries created via
+//     /snapshot/create - a successful load_state() keeps the entry and only bumps
+//     its t_last_use (the "last hit time" record). No capacity limit, no LRU, and
+//     remove_contained/contains are never called (the server only saves/loads).
+//     Expiry is purely the long idle TTL (default 30 days).
+//
+// This is a standalone extension file so that the upstream server files only
+// carry a handful of hook calls (see server_prompt_cache::ssd and the
+// ssd->... calls in server-task.cpp) - rebasing against upstream stays cheap.
+struct server_prompt_cache_ssd {
+    struct entry {
+        uint64_t    id = 0;         // used for the state file name
+        int64_t     t_last_use = 0; // unix ms, last use (hit) time - also the expiry basis
+        size_t      size_total = 0; // main + drft + checkpoints, in bytes
+
+        // plain token ids for LCP matching (same semantics as server_tokens::get_common_prefix)
+        llama_tokens tokens;
+    };
+
+    server_prompt_cache_ssd(std::string path, uint64_t fingerprint, int32_t limit_size_mib,
+                            int64_t ttl_hours, bool keep_on_load = false);
+
+    ~server_prompt_cache_ssd();
+
+    // FNV-1a 64-bit hash used for the fingerprint
+    static uint64_t make_fingerprint(const std::string & s);
+
+    // load the index from disk, wiping the directory on fingerprint/format mismatch
+    bool init();
+
+    // remove entries whose last use is older than the configured TTL (hours).
+    // Lazy: called at init() and at the top of save_state()/load_state().
+    void cleanup_expired();
+
+    // persist a state; returns false on I/O or format errors (state is dropped, not fatal)
+    bool save_state(const server_prompt_cache_state & state);
+
+    // find the best entry for tokens_new using the same f_keep/f_sim policy as the RAM cache,
+    // but only accept it if it beats the given thresholds (the RAM cache's current best).
+    // On success, loads the state into the contexts. api-cache mode then removes the
+    // entry (one-shot restore); snapshot mode keeps it and bumps t_last_use.
+    bool load_state(server_prompt & prompt, const server_tokens & tokens_new,
+                    llama_context * ctx_tgt, llama_context * ctx_dft, int32_t id_slot,
+                    float f_keep_min, float f_sim_min);
+
+    // remove entries whose tokens are fully contained in the given prompt (obsolete prefixes)
+    void remove_contained(const server_tokens & tokens_new);
+
+    // true if some entry fully contains the prompt (i.e. no need to store it again)
+    bool contains(const server_tokens & tokens_new) const;
+
+    size_t size() const;
+
+    size_t n_tokens() const;
+
+    size_t n_entries() const { return entries.size(); }
+
+    // QwenMax: expose the entry token streams so that cache-aware
+    // re-tokenization can heal prompts against SSD state (the only candidates
+    // available right after a cold start, when slots and RAM cache are empty)
+    const std::list<entry> & entries_view() const { return entries; }
+
+private:
+    bool save_index() const;
+    void make_room(size_t size_new);
+    void remove_entry(std::list<entry>::iterator it);
+
+    std::string path_dir;
+    std::string path_index;
+
+    uint64_t fingerprint = 0;
+
+    // in bytes, 0 = no limit
+    size_t limit_size = 0;
+
+    // entry TTL in ms, 0 = disabled (see --cache-ssd-ttl-hours / --cache-snapshot-ttl-hours)
+    int64_t ttl_ms = 0;
+
+    // true = snapshot mode: load_state() keeps the entry (only bumps t_last_use)
+    bool keep_on_load = false;
+
+    size_t next_id = 1;
+
+    std::list<entry> entries;
+};
