+        }
+        if (!best || slot.prompt.n_tokens() > best->prompt.n_tokens()) {
+            if (slot.prompt.n_tokens() > 0) {
+                best = &slot;
+            }
+        }
+    }
+    if (best == nullptr) {
+        return {{"ok", false}, {"error", "no slot with a loaded prompt to snapshot"}};
+    }
+    if (best->prompt.tokens.find_next_media_chunk(0).first != nullptr) {
+        return {{"ok", false}, {"error", "snapshot of media-bearing prompts is not supported (text-only)"}};
