+// QwenMax diagnostic: log fatal SEH exceptions (access violation etc.) with the
+// [QwenMax C09 merge-strategy] Windows-generic VEH logger; candidate for a small
+// upstream PR (needs to be made generic / config-gated first). Keep local for now.
+// faulting address and a raw stack trace. We run without a debugger and WER takes
+// the process silently, so this is the only way to localize crashes in the field.
+#if defined(_WIN32)
+static LONG WINAPI qwenmax_crash_log(EXCEPTION_POINTERS * ep) {
+    const DWORD code = ep->ExceptionRecord->ExceptionCode;
+    if (code == 0xC0000005 || code == 0xC00000FD || code == 0xC0000409 || code == 0x80000003) {
+        void * addr = ep->ExceptionRecord->ExceptionAddress;
+        uintptr_t info0 = ep->ExceptionRecord->ExceptionInformation[0];
+        uintptr_t info1 = ep->ExceptionRecord->ExceptionInformation[1];
+
+        HMODULE mod = nullptr;
+        if (!GetModuleHandleExW(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS | GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
+                                (LPCWSTR) addr, &mod)) {
+            mod = nullptr;
+        }
+        char modname[MAX_PATH] = "?";
+        if (mod) {
+            GetModuleFileNameA(mod, modname, MAX_PATH);
+        }
+
+        void * frames[32] = {};
+        USHORT n_frames = CaptureStackBackTrace(0, 32, frames, nullptr);
+
+        char buf[2048];
+        int off = snprintf(buf, sizeof(buf),
+                "QWENMAX CRASH: code=0x%08lX addr=%p RVA=+0x%llX module=%s base=%p AV-%s @%p thread=%lu\n",
+                code, addr, mod ? (unsigned long long) ((uintptr_t) addr - (uintptr_t) mod) : 0ull,
+                modname, (void *) (uintptr_t) mod,
+                info0 == 0 ? "READ" : (info0 == 1 ? "WRITE" : "EXEC"), (void *) info1,
+                GetCurrentThreadId());
+        if (mod) {
+            for (USHORT i = 0; i < n_frames && off > 0 && off < (int) sizeof(buf) - 48; i++) {
+                const bool in_mod = (uintptr_t) frames[i] >= (uintptr_t) mod &&
+                                    (uintptr_t) frames[i] < (uintptr_t) mod + 0x40000000ull;
+                off += snprintf(buf + off, sizeof(buf) - off, "  [%02u] %p%s",
+                                i, frames[i], in_mod ? "" : "");
+                if (in_mod) {
+                    off += snprintf(buf + off, sizeof(buf) - off, " RVA=+0x%llX",
+                                    (unsigned long long) ((uintptr_t) frames[i] - (uintptr_t) mod));
+                }
+                off += snprintf(buf + off, sizeof(buf) - off, "\n");
+            }
+        }
+        fputs(buf, stderr);
+        fflush(stderr);
+        OutputDebugStringA(buf);
+    }
+    return EXCEPTION_CONTINUE_SEARCH;
+}
+
+static bool qwenmax_veh_installed = []() {
+    AddVectoredExceptionHandler(1, qwenmax_crash_log);
+    return true;
+}();
